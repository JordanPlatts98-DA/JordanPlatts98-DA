# Manchester United performances from 2011 to 2015 seasons using the soccer database on DataCamp

# 4 tables will be used from this database:
    # Country
    # League
    # match
    # team

# 1. Return the team id for manchester united

SELECT team_api_id, team_long_name
FROM soccer.team
WHERE team_long_name = 'Manchester United'

# 2. All home game outcomes

SELECT 
	m.date,
	t.team_long_name AS opponent,
	CASE WHEN m.home_goal > m.away_goal THEN 'Manchester United win'
        WHEN m.home_goal < m.away_goal THEN 'Manchester United loss' 
        ELSE 'Tie' END AS outcome 
FROM soccer.match AS m
LEFT JOIN soccer.team AS t 
ON m.awayteam_id = t.team_api_id
WHERE m.hometeam_id = 10260;

# 3. All home game outcomes 

SELECT 
	m.date,
	t.team_long_name AS opponent,
	CASE WHEN m.home_goal < m.away_goal THEN 'Manchester United win'
        WHEN m.home_goal > m.away_goal THEN 'Manchester United loss' 
        ELSE 'Tie' END AS outcome 
FROM soccer.match AS m
LEFT JOIN soccer.team AS t 
ON m.awayteam_id = t.team_api_id
WHERE m.hometeam_id = 10260;

# 4. Counting home and away wins by season

SELECT season,
COUNT(CASE WHEN hometeam_id = 10260
        AND home_goal > away_goal
        THEN id END) AS home_wins,
COUNT(CASE WHEN awayteam_id = 10260
        AND away_goal > home_goal
        THEN id END) AS away_wins
FROM soccer.match
GROUP BY season;

# 5. Counting home and away losses by season

SELECT season,
COUNT(CASE WHEN hometeam_id = 10260
        AND home_goal < away_goal
        THEN id END) AS home_losses,
COUNT(CASE WHEN awayteam_id = 10260
        AND away_goal > home_goal
        THEN id END) AS away_losses
FROM soccer.match
GROUP BY season;

# 6. Counting home and away draws by season

SELECT season,
COUNT(CASE WHEN hometeam_id = 10260
        AND home_goal = away_goal
        THEN id END) AS home_draws,
COUNT(CASE WHEN awayteam_id = 10260
        AND away_goal = home_goal
        THEN id END) AS away_draws
FROM soccer.match
GROUP BY season;

# 7. Counting home and away goals scored by season

SELECT season,
        SUM(CASE WHEN hometeam_id = 10260
            THEN home_goal END) AS home_goals_scored,
        SUM(CASE WHEN awayteam_id = 10260
            THEN away_goal END) as away_goals_scored
FROM soccer.match
GROUP BY season;

# 8. Counting home and away goals conceded by season

SELECT season,
        SUM(CASE WHEN hometeam_id = 10260
            THEN away_goal END) AS home_goals_conceded,
        SUM(CASE WHEN awayteam_id = 10260
            THEN home_goal END) as away_goals_conceded
FROM soccer.match
GROUP BY season;

# 9. Average goals scored home and away by season

SELECT season,
        ROUND(AVG(CASE WHEN hometeam_id = 10260
            THEN home_goal END), 2) AS avg_home_goals_scored,
        ROUND(AVG(CASE WHEN awayteam_id = 10260
            THEN away_goal END), 2) as avg_away_goals_scored
FROM soccer.match
GROUP BY season;

# 10. Average goals conceded home and away by season

SELECT season,
        ROUND(AVG(CASE WHEN hometeam_id = 10260
            THEN away_goal END), 2) AS avg_home_goals_conceded,
        ROUND(AVG(CASE WHEN awayteam_id = 10260
            THEN home_goal END), 2) as avg_away_goals_conceded
FROM soccer.match
GROUP BY season;

# 11. Percentage of games won home and away by season

SELECT season,
	ROUND(AVG(CASE WHEN hometeam_id = 10260 AND home_goal > away_goal THEN 1
        WHEN hometeam_id = 10260 AND home_goal < away_goal THEN 0
        END), 2) AS pct_homewins,
	ROUND(AVG(CASE WHEN awayteam_id = 10260 AND away_goal > home_goal THEN 1
        WHEN awayteam_id = 10260 AND away_goal < home_goal THEN 0
        END), 2) AS pct_awaywins
FROM soccer.match
GROUP BY season;

# 12. Percentage of games lost home and away by season

SELECT season,
	ROUND(AVG(CASE WHEN hometeam_id = 10260 AND home_goal > away_goal THEN 0
        WHEN hometeam_id = 10260 AND home_goal < away_goal THEN 1
        END), 2) AS pct_homelosses,
	ROUND(AVG(CASE WHEN awayteam_id = 10260 AND away_goal > home_goal THEN 0
        WHEN awayteam_id = 10260 AND away_goal < home_goal THEN 1
        END), 2) AS pct_awaylosses
FROM soccer.match
GROUP BY season;

# 13. Fixture dates, teams involved and scoreline for the 2011/2012 season

WITH home AS (
  SELECT m.id, t.team_long_name,
	  CASE WHEN m.home_goal > m.away_goal THEN 'MU Win'
		   WHEN m.home_goal < m.away_goal THEN 'MU Loss' 
  		   ELSE 'Tie' END AS outcome
  FROM soccer.match AS m
  LEFT JOIN soccer.team AS t ON m.hometeam_id = t.team_api_id),
away AS (
  SELECT m.id, t.team_long_name,
	  CASE WHEN m.home_goal > m.away_goal THEN 'MU Win'
		   WHEN m.home_goal < m.away_goal THEN 'MU Loss' 
  		   ELSE 'Tie' END AS outcome
  FROM soccer.match AS m
  LEFT JOIN soccer.team AS t ON m.awayteam_id = t.team_api_id)
SELECT DISTINCT
    m.date,
    home.team_long_name AS home_team,
    away.team_long_name AS away_team,
    m.home_goal,
    m.away_goal
FROM soccer.match AS m
LEFT JOIN home ON m.id = home.id
LEFT JOIN away ON m.id = away.id
WHERE m.season = '2011/2012'
      AND (home.team_long_name = 'Manchester United' 
           OR away.team_long_name = 'Manchester United');

